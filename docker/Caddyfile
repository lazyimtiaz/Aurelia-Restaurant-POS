{
    auto_https off
    admin off
    frankenphp
}

:{$PORT:8080} {
    root * /app/public
    encode zstd br gzip

    @immutable path /build/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    @images path /images/*
    header @images Cache-Control "public, max-age=86400"

    php_server
}
